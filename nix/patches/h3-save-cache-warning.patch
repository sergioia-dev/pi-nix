+def _path_looks_mangled(value: str) -> bool:
+    """Whether a ``source_file`` is a percent-encoded or non-NFC path spelling.
+
+    Distinguishes the two very different causes behind the "no source_file
+    resolves to a real file" warning below: a genuinely mis-anchored ``root``,
+    versus a model that echoed back a mangled spelling of a dispatched file
+    (``%2D`` for ``-``, a decomposed accent). Only the second is fixable by
+    re-running, so the warning must not blame ``root`` for it (#1890/#2973).
+    """
+    if not value:
+        return False
+    try:
+        if unquote(value) != value:
+            return True
+    except Exception:  # noqa: BLE001 -- a malformed escape is not a mangled path
+        pass
+    return nfc(value) != value
+
