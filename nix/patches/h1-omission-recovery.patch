+def _reported_source_files(result: dict) -> set[str]:
+    """Every ``source_file`` the model reported in one chunk result.
+
+    After ``_reconcile_source_files`` these are the canonical relative spellings
+    that ``_unit_rel`` produces, so a plain set difference against the dispatched
+    units identifies the files the model silently omitted.
+    """
+    out: set[str] = set()
+    for bucket in ("nodes", "edges", "hyperedges"):
+        for item in result.get(bucket, []) or []:
+            if isinstance(item, dict):
+                sf = item.get("source_file")
+                if isinstance(sf, str) and sf:
+                    out.add(sf)
+    return out
+
+
+def _unit_carries_no_text(unit, root: Path) -> bool:
+    """True when a dispatched unit has no non-whitespace text to extract from.
+
+    Such a file legitimately yields no nodes, so counting its absence as an
+    omission would re-dispatch it on every run down to the recursion cap and
+    stamp it partial forever. An unreadable file is likewise not the model's
+    fault.
+    """
+    p = unit_path(unit)
+    safe = _resolve_under_root(p, root)
+    if safe is None:
+        return True
+    try:
+        content = read_slice_text(unit) if isinstance(unit, FileSlice) else _file_to_text(safe)
+    except Exception:  # noqa: BLE001 -- unreadable is not an omission
+        return True
+    return not content.strip()
+
+
+def _missing_dispatched_rels(chunk: list, result: dict, root: Path) -> list[str]:
+    """Dispatched files this clean response omitted, in prompt order.
+
+    ``extract_corpus_parallel`` detects the same gap (#1890) only once every
+    chunk has been billed, and then merely warns -- so the recovery it promises
+    ("a re-run will retry them") costs a whole-corpus re-extraction. Detecting it
+    per chunk lets the adaptive-retry path re-dispatch just the omitted files
+    while the run is still in flight.
+    """
+    reported = _reported_source_files(result)
+    missing: list[str] = []
+    for unit in chunk:
+        rel = _unit_rel(unit, root)
+        if rel in reported or _unit_carries_no_text(unit, root):
+            continue
+        missing.append(rel)
+    return missing
+
+
+def _show_names(paths: list[str], limit: int = 5) -> str:
+    """``a.md, b.md (+3 more)`` -- shared by the omission warnings."""
+    names = [Path(p).name for p in paths]
+    shown = ", ".join(names[:limit])
+    return f"{shown} (+{len(names) - limit} more)" if len(names) > limit else shown
+
